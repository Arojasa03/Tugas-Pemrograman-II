<?xml version="1.0" encoding="UTF-8"?>

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
name="barang"
pageWidth="595"
pageHeight="842"
columnWidth="555"
leftMargin="20"
rightMargin="20"
topMargin="20"
bottomMargin="20">

    <queryString>
        <![CDATA[SELECT * FROM barang]]>
    </queryString>

    <field name="id_barang" class="java.lang.String"/>
    <field name="nama_barang" class="java.lang.String"/>
    <field name="harga" class="java.lang.Integer"/>
    <field name="stok" class="java.lang.Integer"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="180" y="10" width="200" height="30"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[LAPORAN INVENTORY]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">

            <staticText>
                <reportElement x="0" y="0" width="120" height="20"/>
                <text><![CDATA[ID Barang]]></text>
            </staticText>

            <staticText>
                <reportElement x="130" y="0" width="120" height="20"/>
                <text><![CDATA[Nama Barang]]></text>
            </staticText>

            <staticText>
                <reportElement x="260" y="0" width="120" height="20"/>
                <text><![CDATA[Harga]]></text>
            </staticText>

            <staticText>
                <reportElement x="390" y="0" width="120" height="20"/>
                <text><![CDATA[Stok]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="20">

            <textField>
                <reportElement x="0" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{id_barang}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="130" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{nama_barang}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="260" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{harga}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="390" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{stok}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>